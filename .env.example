# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o .env para o Git (ele já está no .gitignore).

# URL pública do site (usada em SEO, RSS e sitemap)
SITE_URL="https://vortice.exemplo.com"

# Supabase — em Project Settings > API
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_ANON_KEY="sua-anon-key"

# Resend — para o aviso por e-mail de novas mensagens de contato (https://resend.com)
RESEND_API_KEY="re_xxxxxxxx"
# Remetente verificado no Resend (para testes pode usar onboarding@resend.dev)
EMAIL_FROM="Vórtice <onboarding@resend.dev>"
# Para qual e-mail você quer receber o aviso de novas mensagens
ADMIN_EMAIL="seu-email@exemplo.com"

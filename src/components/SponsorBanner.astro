---
export interface Props {
  sponsor_name: string;
  sponsor_url?: string;
  sponsor_badge?: string;
}

const { sponsor_name, sponsor_url, sponsor_badge } = Astro.props;
---

<aside class="sponsor-banner" aria-label="Conteúdo patrocinado">
  <div class="sponsor-inner">
    <div class="sponsor-label">
      <span class="sponsor-badge-tag">{sponsor_badge ?? 'Patrocinado'}</span>
    </div>
    <div class="sponsor-info">
      <p class="sponsor-text">
        Este artigo foi patrocinado por{' '}
        {sponsor_url ? (
          <a href={sponsor_url} target="_blank" rel="noopener sponsored">{sponsor_name}</a>
        ) : (
          <strong>{sponsor_name}</strong>
        )}.
      </p>
      {sponsor_url && (
        <a class="sponsor-link" href={sponsor_url} target="_blank" rel="noopener sponsored">
          Visitar {sponsor_name} →
        </a>
      )}
    </div>
  </div>
</aside>

<style>
  .sponsor-banner {
    border: 1px solid var(--color-accent-light, #ede9ff);
    border-left: 4px solid var(--color-accent, #5c4de0);
    border-radius: 6px;
    background: var(--color-accent-light, #ede9ff);
    padding: 1rem 1.25rem;
    margin: 2rem 0;
  }

  .sponsor-inner {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .sponsor-badge-tag {
    display: inline-flex;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25em 0.6em;
    border-radius: 4px;
    background: var(--color-accent, #5c4de0);
    color: #fff;
    white-space: nowrap;
    margin-top: 0.1rem;
  }

  .sponsor-info {
    flex: 1;
  }

  .sponsor-text {
    font-size: 0.875rem;
    color: var(--color-text, #111);
    margin: 0 0 0.4rem;
    line-height: 1.5;
  }

  .sponsor-text a {
    color: var(--color-accent, #5c4de0);
    font-weight: 600;
  }

  .sponsor-link {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent, #5c4de0);
    text-decoration: none;
  }

  .sponsor-link:hover {
    text-decoration: underline;
  }
</style>

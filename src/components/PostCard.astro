---
import { formatDate, localizedPath, type Locale } from '../lib/i18n';

export interface Props {
  title: string;
  slug: string;
  excerpt?: string;
  created_at: string;
  is_sponsored?: boolean;
  sponsor_name?: string;
  image_url?: string;
  image_alt?: string;
  locale?: Locale;
  readMoreLabel?: string;
  sponsoredLabel?: string;
  sponsoredByLabel?: string;
}

const { title, slug, excerpt, created_at, is_sponsored, sponsor_name, image_url, image_alt, locale = 'pt-BR', readMoreLabel = 'Ler artigo', sponsoredLabel = 'Patrocinado', sponsoredByLabel = 'por' } = Astro.props;
const articleHref = localizedPath(`/artigos/${slug}`, locale);

const date = formatDate(created_at, locale);
---

<article class="post-card">
  <span class="post-index" aria-hidden="true"></span>
  {image_url && <a href={articleHref} class="post-image" tabindex="-1" aria-hidden="true"><img src={image_url} alt={image_alt || ''} width="400" height="210" loading="lazy" /></a>}
  <div class="post-body">
  <div class="post-meta">
    <time datetime={created_at}>{date}</time>
    {is_sponsored && (
      <span class="badge-sponsored">{sponsoredLabel}{sponsor_name ? ` ${sponsoredByLabel} ${sponsor_name}` : ''}</span>
    )}
  </div>
  <h2 class="post-title">
    <a href={articleHref}>{title}</a>
  </h2>
  {excerpt && <p class="post-excerpt">{excerpt}</p>}
  <a href={articleHref} class="read-more" aria-label={`${readMoreLabel}: ${title}`}>{readMoreLabel} <span>↗</span></a>
  </div>
  <a href={articleHref} class="post-arrow" tabindex="-1" aria-hidden="true">↗</a>
</article>

<style>
  .post-card {
    position:relative;display:grid;grid-template-columns:36px 1fr auto;gap:1.2rem;align-items:start;padding:2.25rem 1rem;
    border-bottom: 1px solid var(--color-border, #e8e8e8);
  }
  .post-card{transition:background .25s ease,padding .25s ease}.post-card:hover{background:linear-gradient(90deg,rgba(155,135,255,.07),transparent 72%);padding-left:1.4rem}.post-index::before{content:'//';font:400 .62rem var(--font-mono);color:#625e6b}.post-body{min-width:0}.post-image{display:block;width:clamp(150px,20vw,235px);aspect-ratio:1.65;overflow:hidden;border-radius:12px;background:var(--color-surface)}.post-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .35s ease}.post-card:hover .post-image img{transform:scale(1.035)}.post-arrow{align-self:center;display:grid;place-items:center;width:42px;height:42px;border:1px solid var(--color-border);border-radius:50%;color:var(--color-muted);transition:.2s ease}.post-card:hover .post-arrow{color:var(--color-cyan);border-color:rgba(110,231,242,.35);transform:rotate(8deg)}

  .post-card:last-child {
    border-bottom: none;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  time {
    font:400 .67rem var(--font-mono);
    color: var(--color-muted, #666);
    letter-spacing: 0.01em;
  }

  .badge-sponsored {
    display: inline-flex;
    align-items: center;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    background: var(--color-accent-light, #ede9ff);
    color: var(--color-accent, #5c4de0);
  }

  .post-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size:clamp(1.35rem,2.7vw,1.85rem);font-weight:600;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .post-title a {
    color: var(--color-text, #111);
    text-decoration: none;
  }

  .post-title a:hover {
    color:var(--color-cyan,#6ee7f2);
  }

  .post-excerpt {
    font-size: 0.95rem;
    color:var(--color-muted,#9896a3);max-width:760px;
    line-height: 1.65;
    margin-bottom: 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    display:none;font-size:.75rem;
    font-weight: 600;
    color: var(--color-accent, #5c4de0);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .read-more span{margin-left:.35rem}@media(max-width:640px){.post-card{grid-template-columns:24px 1fr;padding:1.7rem 0}.post-card:hover{padding-left:.4rem}.post-arrow{display:none}.post-excerpt{-webkit-line-clamp:2}.post-index::before{font-size:.55rem}}

  /* More breathing room between entries */
  .post-card{grid-template-columns:40px auto minmax(0,1fr) auto;gap:1.75rem;padding:2.75rem 1.25rem}.post-card:not(:has(.post-image)){grid-template-columns:40px minmax(0,1fr) auto}.post-card:hover{background:linear-gradient(90deg,rgba(108,77,230,.055),transparent 72%);padding-left:1.65rem}.post-meta,.post-title{margin-bottom:.8rem}.post-excerpt{margin-bottom:1rem}
  @media(max-width:760px){.post-card,.post-card:not(:has(.post-image)){grid-template-columns:20px minmax(0,1fr);gap:.8rem;padding:2rem 0}.post-card:hover{padding-left:.3rem}.post-image{grid-column:2;width:100%;aspect-ratio:16/9;margin-bottom:.45rem}.post-body{grid-column:2}.post-excerpt{-webkit-line-clamp:3}}
  .read-more:hover {
    text-decoration: underline;
  }
</style>

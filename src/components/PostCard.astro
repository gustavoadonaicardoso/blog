---
export interface Props {
  title: string;
  slug: string;
  excerpt?: string;
  created_at: string;
  is_sponsored?: boolean;
  sponsor_name?: string;
}

const { title, slug, excerpt, created_at, is_sponsored, sponsor_name } = Astro.props;

const date = new Date(created_at).toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<article class="post-card">
  <div class="post-meta">
    <time datetime={created_at}>{date}</time>
    {is_sponsored && (
      <span class="badge-sponsored">Patrocinado{sponsor_name ? ` por ${sponsor_name}` : ''}</span>
    )}
  </div>
  <h2 class="post-title">
    <a href={`/artigos/${slug}`}>{title}</a>
  </h2>
  {excerpt && <p class="post-excerpt">{excerpt}</p>}
  <a href={`/artigos/${slug}`} class="read-more" aria-label={`Ler: ${title}`}>Ler artigo →</a>
</article>

<style>
  .post-card {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border, #e8e8e8);
  }

  .post-card:last-child {
    border-bottom: none;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  time {
    font-size: 0.82rem;
    color: var(--color-muted, #666);
    letter-spacing: 0.01em;
  }

  .badge-sponsored {
    display: inline-flex;
    align-items: center;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2em 0.6em;
    border-radius: 4px;
    background: var(--color-accent-light, #ede9ff);
    color: var(--color-accent, #5c4de0);
  }

  .post-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .post-title a {
    color: var(--color-text, #111);
    text-decoration: none;
  }

  .post-title a:hover {
    color: var(--color-accent, #5c4de0);
  }

  .post-excerpt {
    font-size: 0.95rem;
    color: var(--color-muted, #666);
    line-height: 1.65;
    margin-bottom: 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent, #5c4de0);
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .read-more:hover {
    text-decoration: underline;
  }
</style>

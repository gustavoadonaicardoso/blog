---
interface Comment {
  id: string;
  name: string;
  content: string;
  created_at: string;
}

interface Props {
  postId: string;
  slug: string;
  comments: Comment[];
  status?: string;
}

const { postId, slug, comments, status } = Astro.props;
---

<section class="comments" id="comentarios" aria-labelledby="comments-title">
  <header class="comments-header">
    <div>
      <span class="eyebrow">Conversa</span>
      <h2 id="comments-title">Comentários <small>{comments.length}</small></h2>
    </div>
    <p>Participe com respeito e contribua para a discussão.</p>
  </header>

  {status === 'enviado' && <p class="notice success" role="status">Comentário enviado. Ele aparecerá após a moderação.</p>}
  {status === 'invalido' && <p class="notice error" role="alert">Revise os campos. O comentário deve ter entre 3 e 2.000 caracteres.</p>}
  {status === 'erro' && <p class="notice error" role="alert">Não foi possível enviar agora. Tente novamente em instantes.</p>}

  <div class="comment-list">
    {comments.length > 0 ? comments.map((comment) => (
      <article class="comment">
        <div class="avatar" aria-hidden="true">{comment.name.slice(0, 1).toUpperCase()}</div>
        <div>
          <header><strong>{comment.name}</strong><time datetime={comment.created_at}>{new Date(comment.created_at).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' })}</time></header>
          <p>{comment.content}</p>
        </div>
      </article>
    )) : <p class="empty">Ainda não há comentários publicados. Seja a primeira pessoa a participar.</p>}
  </div>

  <form class="comment-form" id="comentar" action="/api/comentarios" method="POST">
    <input type="hidden" name="post_id" value={postId} />
    <input type="hidden" name="slug" value={slug} />
    <div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
    <div class="form-heading"><div><span class="eyebrow">Sua voz</span><h3>Deixe um comentário</h3></div><span class="required">Todos os campos são obrigatórios</span></div>
    <div class="fields">
      <label>Nome<input name="name" type="text" minlength="2" maxlength="80" autocomplete="name" required /></label>
      <label>E-mail <small>(não será publicado)</small><input name="email" type="email" maxlength="254" autocomplete="email" required /></label>
    </div>
    <label>Comentário<textarea name="content" minlength="3" maxlength="2000" rows="6" required></textarea></label>
    <div class="submit-row"><p>Ao enviar, você concorda com a moderação do conteúdo.</p><button type="submit">Enviar comentário <span>→</span></button></div>
  </form>
</section>

<style>
  .comments{max-width:760px;margin-top:4rem;padding-top:3rem;border-top:1px solid var(--color-border)}.comments-header{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:2rem}.comments-header h2,.comment-form h3{font-family:var(--font-serif);letter-spacing:-.03em}.comments-header h2{font-size:2rem}.comments-header h2 small{display:inline-grid;place-items:center;min-width:1.75rem;height:1.75rem;margin-left:.35rem;border-radius:50%;background:var(--color-accent-light);color:var(--color-accent);font:600 .7rem var(--font-sans)}.comments-header>p{max-width:300px;color:var(--color-muted);font-size:.82rem;line-height:1.6}.eyebrow{display:block;margin-bottom:.45rem;color:var(--color-accent);font-size:.62rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.notice{margin-bottom:1.5rem;padding:.85rem 1rem;border-radius:8px;font-size:.85rem}.notice.success{background:#effaf4;color:#17603a}.notice.error{background:#fff1f1;color:#922}.comment-list{display:grid;gap:0}.comment{display:grid;grid-template-columns:42px 1fr;gap:1rem;padding:1.4rem 0;border-bottom:1px solid var(--color-border)}.avatar{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:var(--color-accent-light);color:var(--color-accent);font-weight:700}.comment header{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:.45rem}.comment strong{font-size:.88rem}.comment time{font-size:.7rem;color:var(--color-muted)}.comment p{white-space:pre-wrap;color:var(--color-muted);font-size:.9rem;line-height:1.7}.empty{padding:1.5rem 0;color:var(--color-muted);font-size:.9rem}.comment-form{position:relative;margin-top:2.5rem;padding:2rem;border:1px solid var(--color-border);border-radius:14px;background:rgba(255,255,255,.025)}.form-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1.5rem}.comment-form h3{font-size:1.5rem}.required{color:var(--color-muted);font-size:.65rem}.fields{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.comment-form label{display:block;margin-bottom:1rem;font-size:.75rem;font-weight:600}.comment-form label small{color:var(--color-muted);font-weight:400}.comment-form input,.comment-form textarea{display:block;width:100%;margin-top:.4rem;padding:.75rem .85rem;border:1px solid var(--color-border);border-radius:8px;background:transparent;color:var(--color-text);font:inherit;outline:none}.comment-form textarea{resize:vertical;min-height:130px}.comment-form input:focus,.comment-form textarea:focus{border-color:var(--color-accent);box-shadow:0 0 0 3px var(--color-accent-light)}.submit-row{display:flex;align-items:center;justify-content:space-between;gap:1rem}.submit-row p{max-width:300px;color:var(--color-muted);font-size:.68rem}.submit-row button{display:inline-flex;align-items:center;gap:.8rem;padding:.75rem 1rem;border:0;border-radius:999px;background:var(--color-accent);color:#fff;font-weight:700;cursor:pointer}.honeypot{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;overflow:hidden!important}@media(max-width:600px){.comments-header,.form-heading,.submit-row{align-items:flex-start;flex-direction:column}.fields{grid-template-columns:1fr}.comment-form{padding:1.4rem}.submit-row button{width:100%;justify-content:center}.comments-header>p{max-width:none}}
</style>

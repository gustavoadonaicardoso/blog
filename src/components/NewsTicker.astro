---
import { createClient } from '../lib/supabase';

const supabase = createClient(Astro.cookies, Astro.request);
const { data: latestPosts } = await supabase
  .from('posts')
  .select('title')
  .eq('published', true)
  .order('created_at', { ascending: false })
  .limit(4);

type DollarResponse = { USDBRL?: { bid?: string; pctChange?: string } };
let dollarText = 'Dólar: cotação indisponível';

try {
  const response = await fetch('https://economia.awesomeapi.com.br/json/last/USD-BRL', {
    signal: AbortSignal.timeout(1800),
  });
  if (response.ok) {
    const quote = (await response.json() as DollarResponse).USDBRL;
    const bid = Number(quote?.bid);
    const change = Number(quote?.pctChange);
    if (Number.isFinite(bid)) {
      const price = bid.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 3, maximumFractionDigits: 3 });
      const variation = Number.isFinite(change) ? ` ${change >= 0 ? '▲' : '▼'} ${Math.abs(change).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}%` : '';
      dollarText = `Dólar comercial ${price}${variation}`;
    }
  }
} catch {
  // A faixa continua exibindo os artigos quando o serviço de câmbio não responder.
}

const tickerItems = [dollarText, ...(latestPosts ?? []).map((post) => `Última publicação: ${post.title}`)];
---

<div class="news-ticker" role="region" aria-label="Cotação do dólar e últimas publicações">
  <div class="ticker-label"><span></span> Agora</div>
  <div class="ticker-viewport">
    <div class="ticker-track">
      <div class="ticker-set">
        {tickerItems.map((item) => <span class="ticker-item">{item}</span>)}
      </div>
      <div class="ticker-set" aria-hidden="true">
        {tickerItems.map((item) => <span class="ticker-item">{item}</span>)}
      </div>
    </div>
  </div>
</div>

<style>
  .news-ticker{height:34px;display:flex;align-items:stretch;overflow:hidden;background:#171321;color:#f7f5ff;border-bottom:1px solid rgba(255,255,255,.1);font:500 .62rem var(--font-mono);letter-spacing:.055em;text-transform:uppercase}.ticker-label{position:relative;z-index:2;flex:0 0 auto;display:flex;align-items:center;gap:.48rem;padding:0 1.1rem;background:linear-gradient(110deg,#6c4de6,#5136bd);box-shadow:10px 0 20px rgba(15,10,27,.3)}.ticker-label span{width:5px;height:5px;border-radius:50%;background:#8ff8ec;box-shadow:0 0 8px #8ff8ec}.ticker-viewport{display:flex;align-items:center;overflow:hidden;min-width:0}.ticker-track{display:flex;width:max-content;animation:ticker-scroll 42s linear infinite;will-change:transform}.ticker-set{display:flex;align-items:center;flex-shrink:0}.ticker-item{display:flex;align-items:center;white-space:nowrap}.ticker-item::after{content:'◆';margin:0 2.25rem;color:#8c71f5;font-size:.4rem}@keyframes ticker-scroll{to{transform:translateX(-50%)}}@media(max-width:640px){.news-ticker{height:31px;font-size:.56rem}.ticker-label{padding:0 .75rem}.ticker-item::after{margin:0 1.5rem}}@media(prefers-reduced-motion:reduce){.ticker-track{animation:none}.ticker-set[aria-hidden='true']{display:none}}
</style>

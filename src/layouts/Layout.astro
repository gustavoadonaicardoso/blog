---
import NewsletterPopup from '../components/NewsletterPopup.astro';
import CookieConsent from '../components/CookieConsent.astro';
import NewsTicker from '../components/NewsTicker.astro';
import { copy, getLocale, localeNames, localeOptions, switchLocale, type Locale } from '../lib/i18n';
export interface Props { title?: string; description?: string; image?: string; imageAlt?: string; article?: boolean; locale?: Locale; }
const { title = 'Vórtice', description = 'Ideias que giram.', image, imageAlt, article = false, locale: requestedLocale } = Astro.props;
const locale = requestedLocale ?? getLocale(Astro.url);
const labels = copy[locale];
const pageTitle = title === 'Vórtice' ? 'Vórtice' : `${title} — Vórtice`;
const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, Astro.site ?? Astro.url.origin);
if (locale !== 'pt-BR') canonicalUrl.searchParams.set('lang', locale);
const socialImage = image ? new URL(image, Astro.site ?? Astro.url.origin).toString() : undefined;
---
<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} /><meta name="theme-color" content="#ffffff" />
  <link rel="canonical" href={canonicalUrl.toString()} />
  {localeOptions.map((option) => <link rel="alternate" hreflang={option.value.toLowerCase()} href={new URL(switchLocale(new URL(pathname, Astro.url), option.value), Astro.url.origin).toString()} />)}
  <meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:site_name" content="Vórtice" />
  <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl.toString()} />
  {socialImage && <meta property="og:image" content={socialImage} />}{socialImage && <meta property="og:image:alt" content={imageAlt || title} />}
  <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} /><meta name="twitter:title" content={pageTitle} /><meta name="twitter:description" content={description} />
  {socialImage && <meta name="twitter:image" content={socialImage} />}{socialImage && <meta name="twitter:image:alt" content={imageAlt || title} />}
  <title>{pageTitle}</title><link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{--color-bg:#fff;--color-surface:#f7f7fa;--color-surface-soft:rgba(75,53,180,.035);--color-text:#17151d;--color-muted:#6f6b78;--color-border:rgba(31,25,48,.12);--color-accent:#6c4de6;--color-cyan:#087f8c;--color-accent-light:rgba(108,77,230,.09);--font-serif:'Space Grotesk',system-ui,sans-serif;--font-sans:'Manrope',system-ui,sans-serif;--font-mono:'DM Mono',monospace;--max-width:1200px;--spacing-sm:.75rem;--spacing-md:1.5rem;--spacing-lg:6rem}
    html{font-size:17px;scroll-behavior:smooth;background:var(--color-bg)}
    body{min-height:100vh;font-family:var(--font-sans);background:radial-gradient(circle at 10% 2%,rgba(108,77,230,.08),transparent 30rem),radial-gradient(circle at 90% 16%,rgba(8,127,140,.055),transparent 28rem),var(--color-bg);color:var(--color-text);line-height:1.7;-webkit-font-smoothing:antialiased}
    body::before{content:'';position:fixed;inset:0;pointer-events:none;opacity:.32;background-image:linear-gradient(rgba(40,30,70,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(40,30,70,.035) 1px,transparent 1px);background-size:64px 64px;mask-image:linear-gradient(to bottom,black,transparent 68%);z-index:-1}
    ::selection{background:var(--color-accent);color:#fff}a{color:var(--color-accent);text-decoration:none}h1,h2,h3,h4{font-family:var(--font-serif);line-height:1.12;font-weight:600}img{max-width:100%;height:auto}.container{width:min(calc(100% - 3rem),var(--max-width));margin-inline:auto}
    .site-header{position:sticky;top:0;z-index:20;border-bottom:1px solid var(--color-border);background:rgba(8,8,12,.72);backdrop-filter:blur(18px) saturate(140%)}.site-header .container{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:2rem}.site-logo{display:inline-flex;align-items:center;gap:.7rem;font-family:var(--font-serif);font-size:1.18rem;font-weight:700;letter-spacing:-.03em;color:var(--color-text)}.logo-mark{width:29px;aspect-ratio:1;display:grid;place-items:center;border:1px solid rgba(155,135,255,.6);border-radius:50%;box-shadow:inset 0 0 12px rgba(155,135,255,.24),0 0 18px rgba(155,135,255,.12)}.logo-mark::before{content:'';width:9px;height:9px;border:2px solid var(--color-cyan);border-radius:50%;box-shadow:0 0 8px var(--color-cyan)}.site-logo:hover{color:#fff}.site-nav{display:flex;align-items:center;gap:.35rem;list-style:none}.site-nav a{position:relative;display:block;padding:.55rem .85rem;border-radius:999px;color:var(--color-muted);font-size:.78rem;font-weight:600;letter-spacing:.04em;transition:.2s ease}.site-nav a:hover,.site-nav a[aria-current='page']{color:var(--color-text);background:rgba(255,255,255,.055)}.site-nav a[aria-current='page']::after{content:'';position:absolute;left:50%;bottom:3px;width:3px;height:3px;background:var(--color-cyan);border-radius:50%;box-shadow:0 0 7px var(--color-cyan)}
    .site-main{min-height:calc(100vh - 180px);padding:var(--spacing-lg) 0}.site-footer{border-top:1px solid var(--color-border);margin-top:4rem}.site-footer .container{min-height:120px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem}.site-footer p,.site-footer a{font-family:var(--font-mono);font-size:.69rem;color:var(--color-muted);letter-spacing:.03em}.site-footer a:hover{color:var(--color-cyan)}
    .badge{display:inline-flex;align-items:center;font-family:var(--font-mono);font-size:.64rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;padding:.3em .7em;border:1px solid rgba(155,135,255,.3);border-radius:999px;background:var(--color-accent-light);color:#c7bcff}.form-group{margin-bottom:1.25rem}label{display:block;font-size:.78rem;font-weight:600;margin-bottom:.5rem;color:#cfccd6}input[type='text'],input[type='email'],input[type='url'],input[type='password'],textarea,select{width:100%;padding:.82rem 1rem;border:1px solid var(--color-border);border-radius:10px;font:.9rem var(--font-sans);color:var(--color-text);background:rgba(255,255,255,.035);transition:.2s ease;outline:none}input::placeholder,textarea::placeholder{color:#64616d}input:focus,textarea:focus,select:focus{border-color:var(--color-accent);background:rgba(155,135,255,.05);box-shadow:0 0 0 4px rgba(155,135,255,.1)}textarea{min-height:140px;resize:vertical}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:.72rem 1.25rem;border-radius:999px;border:1px solid transparent;font:600 .79rem var(--font-sans);cursor:pointer;transition:transform .2s,background .2s,border-color .2s,box-shadow .2s;text-decoration:none}.btn:hover{transform:translateY(-2px);text-decoration:none}.btn-primary{background:linear-gradient(120deg,#8269ff,#a78bfa);color:#fff;box-shadow:0 9px 30px rgba(126,96,255,.22)}.btn-primary:hover{box-shadow:0 12px 36px rgba(126,96,255,.35);color:#fff}.btn-secondary{background:rgba(255,255,255,.035);color:var(--color-text);border-color:var(--color-border)}.btn-secondary:hover{border-color:rgba(155,135,255,.55);background:var(--color-accent-light)}.btn-danger{background:#dc2626;color:#fff}.btn-sm{padding:.4rem .85rem;font-size:.72rem}.alert{padding:.9rem 1rem;border-radius:10px;margin-bottom:1.25rem;font-size:.85rem}.alert-success{background:rgba(34,197,94,.1);color:#86efac;border:1px solid rgba(34,197,94,.3)}.alert-error{background:rgba(239,68,68,.1);color:#fca5a5;border:1px solid rgba(239,68,68,.3)}.checkbox-group{display:flex;align-items:center;gap:.5rem;margin-bottom:1.25rem}.checkbox-group input[type='checkbox']{width:auto;margin:0;accent-color:var(--color-accent)}.checkbox-group label{margin:0;font-weight:500;cursor:pointer}
    /* Light theme refinements */
    .site-header{background:rgba(255,255,255,.84)}.site-header .container{min-height:86px}.site-logo:hover{color:var(--color-accent)}.site-logo img{display:block;width:auto;height:52px;max-width:208px;object-fit:contain}.header-actions{display:flex;align-items:center;gap:1rem}.language-switcher{display:flex;align-items:center;gap:.2rem;padding:.2rem;border:1px solid var(--color-border);border-radius:999px;background:#fff;font:500 .58rem var(--font-mono);letter-spacing:.04em}.language-switcher a{padding:.28rem .4rem;border-radius:999px;color:var(--color-muted)}.language-switcher a:hover,.language-switcher a.active{background:var(--color-accent-light);color:var(--color-accent)}
    .logo-mark{width:31px;border-color:rgba(108,77,230,.45);box-shadow:inset 0 0 12px rgba(108,77,230,.13),0 0 18px rgba(108,77,230,.09)}.logo-mark::before{box-shadow:0 0 7px rgba(8,127,140,.45)}
    .site-nav{gap:.5rem}.site-nav a{padding:.6rem 1rem}.site-nav a:hover,.site-nav a[aria-current='page']{background:rgba(108,77,230,.07)}
    .site-footer{margin-top:6rem}.badge{border-color:rgba(108,77,230,.25);color:var(--color-accent)}label{color:#4d4955}
    input[type='text'],input[type='email'],input[type='url'],input[type='password'],textarea,select{padding:.9rem 1rem;background:#fff}input::placeholder,textarea::placeholder{color:#9a96a1}
    .btn-secondary{background:#fff}.alert-success{color:#157a3b}.alert-error{color:#b42323}
    @media(max-width:900px){:root{--spacing-lg:4.5rem}.container{width:min(calc(100% - 3rem),var(--max-width))}}
    @media(max-width:640px){html{font-size:16px}.container{width:min(calc(100% - 2rem),var(--max-width))}.site-header .container{min-height:70px;gap:.5rem}.site-logo img{height:38px;max-width:142px}.header-actions{gap:.35rem}.site-nav{gap:0}.site-nav a{padding:.45rem .42rem;font-size:.64rem}.language-switcher{font-size:.52rem}.language-switcher a{padding:.25rem .3rem}.site-main{padding-top:3.5rem}}
    @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important}}
  </style>
</head>
<body>
  <NewsTicker locale={locale} />
  <header class="site-header"><div class="container"><a href={switchLocale(new URL('/', Astro.url), locale)} class="site-logo" aria-label={`Vórtice — ${labels.home.toLowerCase()}`}><img src="/logo-vortice.svg" alt="Vórtice" width="240" height="60" /></a><div class="header-actions"><nav aria-label={labels.language}><ul class="site-nav"><li><a href={switchLocale(new URL('/', Astro.url), locale)} aria-current={pathname==='/'?'page':undefined}>{labels.home}</a></li><li><a href={switchLocale(new URL('/artigos', Astro.url), locale)} aria-current={pathname.startsWith('/artigos')?'page':undefined}>{labels.articles}</a></li><li><a href={switchLocale(new URL('/biblioteca', Astro.url), locale)} aria-current={pathname.startsWith('/biblioteca')?'page':undefined}>{labels.library}</a></li><li><a href={switchLocale(new URL('/contato', Astro.url), locale)} aria-current={pathname==='/contato'?'page':undefined}>{labels.contact}</a></li></ul></nav><div class="language-switcher" aria-label={labels.language}>{localeOptions.map((option) => <a href={switchLocale(Astro.url, option.value)} class:list={{ active: option.value === locale }} lang={option.value} aria-current={option.value === locale ? 'true' : undefined} title={localeNames[option.value]}>{option.label}</a>)}</div></div></div></header>
  <main class="site-main"><div class="container"><slot /></div></main>
  <footer class="site-footer"><div class="container"><p>© {new Date().getFullYear()} VÓRTICE / IDEIAS EM MOVIMENTO</p><p><a href="/privacidade">PRIVACIDADE</a> · <a href="/patrocinar">PATROCINE O BLOG ↗</a></p></div></footer>
  <NewsletterPopup />
  <CookieConsent />
</body>
</html>

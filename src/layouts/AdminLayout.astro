---
export interface Props {
  title?: string;
}

const { title = 'Admin' } = Astro.props;
const path = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Vórtice Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --color-bg: #fff;
        --color-text: #111;
        --color-muted: #666;
        --color-border: #e8e8e8;
        --color-accent: #5c4de0;
        --color-accent-light: #ede9ff;
        --color-sidebar-bg: #0f0f0f;
        --color-sidebar-text: #e5e5e5;
        --color-sidebar-muted: #888;
        --color-sidebar-hover: #1c1c1c;
        --color-sidebar-active: #5c4de0;
        --font-serif: Georgia, 'Times New Roman', serif;
        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --sidebar-width: 220px;
      }

      html {
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
      }

      body {
        font-family: var(--font-sans);
        background: #f8f8f8;
        color: var(--color-text);
        line-height: 1.6;
        display: flex;
        min-height: 100vh;
      }

      a { color: var(--color-accent); text-decoration: none; }
      a:hover { text-decoration: underline; }

      h1, h2, h3 {
        font-family: var(--font-serif);
        font-weight: 700;
        line-height: 1.25;
      }

      /* Sidebar */
      .admin-sidebar {
        width: var(--sidebar-width);
        background: var(--color-sidebar-bg);
        color: var(--color-sidebar-text);
        display: flex;
        flex-direction: column;
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        overflow-y: auto;
        z-index: 100;
      }

      .sidebar-brand {
        padding: 1.4rem 1.25rem 1.2rem;
        border-bottom: 1px solid #1f1f1f;
      }

      .sidebar-brand a {
        font-family: var(--font-serif);
        font-size: 1.2rem;
        font-weight: 700;
        color: #fff;
        text-decoration: none;
      }

      .sidebar-label {
        font-size: 0.65rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-sidebar-muted);
        margin-top: 0.2rem;
      }

      .sidebar-nav {
        flex: 1;
        padding: 1rem 0;
      }

      .sidebar-nav a {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.65rem 1.25rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--color-sidebar-muted);
        text-decoration: none;
        transition: all 0.15s;
        border-left: 3px solid transparent;
      }

      .sidebar-nav a:hover {
        color: var(--color-sidebar-text);
        background: var(--color-sidebar-hover);
        text-decoration: none;
      }

      .sidebar-nav a.active {
        color: #fff;
        background: var(--color-sidebar-hover);
        border-left-color: var(--color-sidebar-active);
      }

      .sidebar-footer {
        padding: 1rem 1.25rem;
        border-top: 1px solid #1f1f1f;
      }

      .sidebar-footer a {
        font-size: 0.8rem;
        color: var(--color-sidebar-muted);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }

      .sidebar-footer a:hover {
        color: #ff6b6b;
        text-decoration: none;
      }

      /* Main content */
      .admin-content {
        margin-left: var(--sidebar-width);
        flex: 1;
        padding: 2rem 2.5rem;
        max-width: calc(100% - var(--sidebar-width));
      }

      .admin-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--color-border);
      }

      .admin-header h1 {
        font-size: 1.6rem;
        color: var(--color-text);
      }

      /* Cards / panels */
      .card {
        background: #fff;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
      }

      /* Stats grid */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .stat-card {
        background: #fff;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.25rem 1.5rem;
        text-align: center;
      }

      .stat-value {
        font-family: var(--font-serif);
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--color-accent);
        line-height: 1;
        margin-bottom: 0.4rem;
      }

      .stat-label {
        font-size: 0.8rem;
        color: var(--color-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      /* Table */
      .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
      }

      .data-table th {
        text-align: left;
        padding: 0.6rem 0.85rem;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-muted);
        border-bottom: 2px solid var(--color-border);
      }

      .data-table td {
        padding: 0.75rem 0.85rem;
        border-bottom: 1px solid var(--color-border);
        vertical-align: middle;
      }

      .data-table tr:last-child td {
        border-bottom: none;
      }

      .data-table tr:hover td {
        background: #fafafa;
      }

      /* Actions row */
      .actions {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
      }

      /* Form elements */
      .form-group { margin-bottom: 1.25rem; }

      label {
        display: block;
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 0.4rem;
      }

      input[type="text"],
      input[type="email"],
      input[type="url"],
      input[type="password"],
      textarea,
      select {
        width: 100%;
        padding: 0.6rem 0.85rem;
        border: 1px solid var(--color-border);
        border-radius: 6px;
        font-family: var(--font-sans);
        font-size: 0.9rem;
        color: var(--color-text);
        background: var(--color-bg);
        outline: none;
        transition: border-color 0.15s;
      }

      input:focus, textarea:focus, select:focus {
        border-color: var(--color-accent);
        box-shadow: 0 0 0 3px rgba(92,77,224,0.1);
      }

      textarea { min-height: 300px; resize: vertical; }

      .checkbox-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
      }

      .checkbox-group input[type="checkbox"] {
        width: auto;
        accent-color: var(--color-accent);
      }

      .checkbox-group label {
        margin: 0;
        font-weight: 500;
        cursor: pointer;
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.55rem 1.2rem;
        border-radius: 6px;
        font-family: var(--font-sans);
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
        border: none;
        text-decoration: none;
      }

      .btn-primary { background: var(--color-accent); color: #fff; }
      .btn-primary:hover { background: #4a3cc0; text-decoration: none; color: #fff; }
      .btn-secondary { background: transparent; color: var(--color-accent); border: 1px solid var(--color-accent); }
      .btn-secondary:hover { background: var(--color-accent-light); text-decoration: none; }
      .btn-danger { background: #dc2626; color: #fff; }
      .btn-danger:hover { background: #b91c1c; text-decoration: none; color: #fff; }
      .btn-sm { padding: 0.3rem 0.75rem; font-size: 0.775rem; }

      .badge {
        display: inline-flex;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 0.2em 0.55em;
        border-radius: 4px;
        background: var(--color-accent-light);
        color: var(--color-accent);
      }

      .badge-green { background: #f0fdf4; color: #166534; }
      .badge-gray { background: #f4f4f4; color: #666; }
      .badge-red { background: #fef2f2; color: #991b1b; }

      .alert {
        padding: 0.85rem 1rem;
        border-radius: 6px;
        margin-bottom: 1.25rem;
        font-size: 0.875rem;
      }

      .alert-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
      .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

      @media (max-width: 768px) {
        .admin-sidebar { width: 100%; height: auto; position: static; flex-direction: row; }
        .admin-content { margin-left: 0; max-width: 100%; padding: 1.25rem; }
      }
    </style>
  </head>
  <body>
    <aside class="admin-sidebar">
      <div class="sidebar-brand">
        <a href="/">Vórtice</a>
        <p class="sidebar-label">Painel Admin</p>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin" class={path === '/admin' ? 'active' : ''}>
          ◈ Dashboard
        </a>
        <a href="/admin/posts" class={path.startsWith('/admin/posts') ? 'active' : ''}>
          ✦ Posts
        </a>
        <a href="/admin/patrocinios" class={path.startsWith('/admin/patrocinios') ? 'active' : ''}>
          ◆ Patrocínios
        </a>
        <a href="/admin/mensagens" class={path.startsWith('/admin/mensagens') ? 'active' : ''}>
          ◇ Mensagens
        </a>
      </nav>
      <div class="sidebar-footer">
        <a href="/api/admin/logout">↩ Sair</a>
      </div>
    </aside>

    <main class="admin-content">
      <div class="admin-header">
        <h1>{title}</h1>
      </div>
      <slot />
    </main>
  </body>
</html>

---
import Layout from '../layouts/Layout.astro';

const success = Astro.url.searchParams.get('ok') === '1';
const error = Astro.url.searchParams.get('erro');
---

<Layout title="Contato" description="Entre em contato com o Vórtice.">
  <div class="page-header">
    <h1>Contato</h1>
    <p class="subtitle">Tem algo a dizer? Adoraria ouvir você.</p>
  </div>

  <aside class="instagram-invite" aria-label="Instagram do Vórtice">
    <div>
      <span class="instagram-label">Acompanhe o Vórtice</span>
      <h2>Vamos continuar essa conversa no Instagram?</h2>
      <p>Siga <strong>@vorticevt</strong> para acompanhar novos conteúdos, ideias e atualizações.</p>
    </div>
    <a
      class="btn btn-secondary instagram-link"
      href="https://www.instagram.com/vorticevt/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Seguir o Vórtice no Instagram (abre em uma nova aba)"
    >
      Seguir no Instagram ↗
    </a>
  </aside>

  {success && (
    <div class="alert alert-success" role="alert">
      Mensagem enviada com sucesso! Obrigado pelo contato.
    </div>
  )}

  {error && (
    <div class="alert alert-error" role="alert">
      Ocorreu um erro ao enviar sua mensagem. Tente novamente.
    </div>
  )}

  <form class="contact-form" method="POST" action="/api/contato">
    <div class="form-group">
      <label for="name">Nome</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        placeholder="Seu nome"
        autocomplete="name"
      />
    </div>

    <div class="form-group">
      <label for="email">E-mail</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder="seu@email.com"
        autocomplete="email"
      />
    </div>

    <div class="form-group">
      <label for="message">Mensagem</label>
      <textarea
        id="message"
        name="message"
        required
        placeholder="Sua mensagem..."
        rows="6"
      ></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Enviar mensagem</button>
  </form>
</Layout>

<style>
  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 7vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--color-muted);
    font-size: 1rem;
  }

  .contact-form {
    max-width: 560px;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface-soft);
  }

  .instagram-invite {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    border: 1px solid rgba(108, 77, 230, 0.2);
    border-radius: 16px;
    background: linear-gradient(120deg, rgba(108, 77, 230, 0.08), rgba(8, 127, 140, 0.06));
  }

  .instagram-label {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--color-accent);
    font: 500 0.64rem var(--font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .instagram-invite h2 {
    margin-bottom: 0.35rem;
    font-size: 1.25rem;
  }

  .instagram-invite p {
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .instagram-link {
    flex-shrink: 0;
  }

  .alert {
    padding: 0.85rem 1rem;
    border-radius: 6px;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .alert-success {
    background: #f0fdf4;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .alert-error {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  @media (max-width: 680px) {
    .instagram-invite {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.25rem;
    }
  }
</style>

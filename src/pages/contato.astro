---
import Layout from '../layouts/Layout.astro';

const success = Astro.url.searchParams.get('ok') === '1';
const error = Astro.url.searchParams.get('erro');
---

<Layout title="Contato" description="Entre em contato com o Vórtice.">
  <div class="page-header">
    <h1>Contato</h1>
    <p class="subtitle">Tem algo a dizer? Adoraria ouvir você.</p>
  </div>

  {success && (
    <div class="alert alert-success" role="alert">
      Mensagem enviada com sucesso! Obrigado pelo contato.
    </div>
  )}

  {error && (
    <div class="alert alert-error" role="alert">
      Ocorreu um erro ao enviar sua mensagem. Tente novamente.
    </div>
  )}

  <form class="contact-form" method="POST" action="/api/contato">
    <div class="form-group">
      <label for="name">Nome</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        placeholder="Seu nome"
        autocomplete="name"
      />
    </div>

    <div class="form-group">
      <label for="email">E-mail</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder="seu@email.com"
        autocomplete="email"
      />
    </div>

    <div class="form-group">
      <label for="message">Mensagem</label>
      <textarea
        id="message"
        name="message"
        required
        placeholder="Sua mensagem..."
        rows="6"
      ></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Enviar mensagem</button>
  </form>
</Layout>

<style>
  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 7vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--color-muted);
    font-size: 1rem;
  }

  .contact-form {
    max-width: 560px;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface-soft);
  }

  .alert {
    padding: 0.85rem 1rem;
    border-radius: 6px;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .alert-success {
    background: #f0fdf4;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .alert-error {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }
</style>

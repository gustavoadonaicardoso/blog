---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAuth } from '../../../lib/auth';
import { createClient } from '../../../lib/supabase';

const authRedirect = await requireAuth(Astro.cookies, Astro.request);
if (authRedirect) return authRedirect;

const { id } = Astro.params;
const supabase = createClient(Astro.cookies, Astro.request);

const { data: post } = await supabase
  .from('posts')
  .select('*')
  .eq('id', id)
  .single();

if (!post) {
  return Astro.redirect('/admin/posts', 302);
}

const saved = Astro.url.searchParams.get('ok') === '1';
const error = Astro.url.searchParams.get('erro');
const errorMessages: Record<string, string> = {
  'formato-imagem': 'Formato inválido. Use JPEG, PNG, WebP ou AVIF.',
  'tamanho-imagem': 'A imagem deve ter no máximo 8 MB.',
  'upload-imagem': 'Não foi possível enviar a imagem. Verifique a configuração do Storage.',
};
---

<AdminLayout title="Editar Post">
  {saved && (
    <div class="alert alert-success">Post atualizado com sucesso.</div>
  )}
  {error && (
    <div class="alert alert-error">{errorMessages[error] ?? 'Erro ao atualizar post. Tente novamente.'}</div>
  )}

  <form method="POST" action="/api/admin/posts/atualizar" enctype="multipart/form-data">
    <input type="hidden" name="id" value={post.id} />

    <div class="form-grid">
      <div class="form-group">
        <label for="title">Título *</label>
        <input type="text" id="title" name="title" required value={post.title} />
      </div>

      <div class="form-group">
        <label for="slug">Slug *</label>
        <input type="text" id="slug" name="slug" required value={post.slug} pattern="[a-z0-9-]+" />
      </div>

      <div class="form-group form-full">
        <label for="excerpt">Resumo</label>
        <textarea id="excerpt" name="excerpt" rows="3" style="min-height: 80px;">{post.excerpt}</textarea>
      </div>

      <div class="form-group form-full image-field">
        <label for="image">Imagem de destaque</label>
        <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp,image/avif" />
        <small>Envie uma nova imagem para substituir a atual. JPEG, PNG, WebP ou AVIF, até 8 MB.</small>
        <img id="imagePreview" class="image-preview" src={post.image_url ?? undefined} hidden={!post.image_url} alt={post.image_alt || 'Prévia da imagem de destaque'} />
        {post.image_url && <label class="remove-image"><input type="checkbox" name="remove_image" value="true" /> Remover imagem atual</label>}
      </div>

      <div class="form-group form-full">
        <label for="image_alt">Descrição da imagem</label>
        <input type="text" id="image_alt" name="image_alt" maxlength="180" value={post.image_alt ?? ''} placeholder="Descreva o que aparece na imagem" />
        <small class="field-help">Ajuda pessoas que utilizam leitores de tela.</small>
      </div>

      <div class="form-group form-full">
        <label for="content">Conteúdo (Markdown)</label>
        <textarea id="content" name="content">{post.content}</textarea>
      </div>
    </div>

    <div class="checkbox-group">
      <input type="checkbox" id="published" name="published" value="true" checked={post.published} />
      <label for="published">Publicado</label>
    </div>

    <div class="checkbox-group">
      <input type="checkbox" id="is_sponsored" name="is_sponsored" value="true" checked={post.is_sponsored} />
      <label for="is_sponsored">Post patrocinado</label>
    </div>

    <div class="sponsor-fields" id="sponsorFields" style={post.is_sponsored ? 'display: block;' : 'display: none;'}>
      <div class="card" style="margin-bottom: 1.25rem;">
        <h3 style="font-family: Georgia, serif; font-size: 0.95rem; margin-bottom: 1rem; color: var(--color-accent);">Informações do patrocinador</h3>

        <div class="form-group">
          <label for="sponsor_name">Nome do patrocinador</label>
          <input type="text" id="sponsor_name" name="sponsor_name" value={post.sponsor_name ?? ''} />
        </div>

        <div class="form-group">
          <label for="sponsor_url">URL do patrocinador</label>
          <input type="url" id="sponsor_url" name="sponsor_url" value={post.sponsor_url ?? ''} />
        </div>

        <div class="form-group">
          <label for="sponsor_badge">Texto do badge</label>
          <input type="text" id="sponsor_badge" name="sponsor_badge" value={post.sponsor_badge ?? ''} />
        </div>
      </div>
    </div>

    <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
      <button type="submit" class="btn btn-primary">Salvar alterações</button>
      <a href="/admin/posts" class="btn btn-secondary">Cancelar</a>
      <a href={`/artigos/${post.slug}`} target="_blank" class="btn btn-secondary">Ver post ↗</a>
    </div>
  </form>
</AdminLayout>

<script>
  const checkbox = document.getElementById('is_sponsored') as HTMLInputElement;
  const fields = document.getElementById('sponsorFields') as HTMLDivElement;

  function toggle() {
    fields.style.display = checkbox.checked ? 'block' : 'none';
  }

  checkbox.addEventListener('change', toggle);

  const imageInput = document.getElementById('image') as HTMLInputElement;
  const imagePreview = document.getElementById('imagePreview') as HTMLImageElement;
  imageInput.addEventListener('change', () => {
    const file = imageInput.files?.[0];
    if (!file) return;
    imagePreview.src = URL.createObjectURL(file);
    imagePreview.hidden = false;
  });
</script>

<style>
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 1.5rem;
  }

  .form-full {
    grid-column: 1 / -1;
  }
  .image-field>small,.field-help{display:block;margin-top:.4rem;color:var(--color-muted);font-size:.72rem}.image-preview{display:block;width:min(100%,680px);aspect-ratio:1200/630;margin-top:1rem;border:1px solid var(--color-border);border-radius:12px;object-fit:cover}.remove-image{display:flex;align-items:center;gap:.5rem;margin-top:.75rem;color:#991b1b;font-size:.75rem}.remove-image input{accent-color:#dc2626}

  @media (max-width: 600px) {
    .form-grid { grid-template-columns: 1fr; }
  }
</style>

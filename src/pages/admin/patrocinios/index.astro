---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAuth } from '../../../lib/auth';
import { createClient } from '../../../lib/supabase';

const authRedirect = await requireAuth(Astro.cookies, Astro.request);
if (authRedirect) return authRedirect;

const supabase = createClient(Astro.cookies, Astro.request);

const { data: sponsoredPosts } = await supabase
  .from('posts')
  .select('id, title, slug, sponsor_name, sponsor_url, published, created_at')
  .eq('is_sponsored', true)
  .order('created_at', { ascending: false });
---

<AdminLayout title="Patrocínios">
  <div class="actions">
    <a href="/admin/patrocinios/interesses" class="btn btn-secondary">Ver interesses recebidos →</a>
    <a href="/patrocinar" target="_blank" class="btn btn-secondary">Ver página pública ↗</a>
  </div>

  <h2 style="font-family: Georgia, serif; font-size: 1rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.07em; font-size: 0.75rem; margin-bottom: 0.75rem;">Posts patrocinados</h2>

  <div class="card" style="padding: 0; overflow: hidden;">
    {sponsoredPosts && sponsoredPosts.length > 0 ? (
      <table class="data-table">
        <thead>
          <tr>
            <th>Post</th>
            <th>Patrocinador</th>
            <th>URL</th>
            <th>Status</th>
            <th>Data</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {sponsoredPosts.map((post) => (
            <tr>
              <td style="font-weight: 600; max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                {post.title}
              </td>
              <td>{post.sponsor_name ?? '—'}</td>
              <td style="font-size: 0.82rem;">
                {post.sponsor_url ? (
                  <a href={post.sponsor_url} target="_blank" rel="noopener">{post.sponsor_url}</a>
                ) : '—'}
              </td>
              <td>
                <span class={`badge ${post.published ? 'badge-green' : 'badge-gray'}`}>
                  {post.published ? 'Ativo' : 'Rascunho'}
                </span>
              </td>
              <td style="font-size: 0.82rem; color: var(--color-muted);">
                {new Date(post.created_at).toLocaleDateString('pt-BR')}
              </td>
              <td>
                <a href={`/admin/posts/${post.id}`} class="btn btn-secondary btn-sm">Editar</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p style="padding: 2rem; color: var(--color-muted);">Nenhum post patrocinado ainda.</p>
    )}
  </div>
</AdminLayout>

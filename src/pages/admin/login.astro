---
import { getSession } from '../../lib/auth';

const session = await getSession(Astro.cookies, Astro.request);
if (session) return Astro.redirect('/admin', 302);

const error = Astro.url.searchParams.get('erro');
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <title>Login — Vórtice Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <style>
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      :root{--accent:#6c4de6;--cyan:#087f8c;--text:#17151d;--muted:#716d79;--border:rgba(31,25,48,.13);--surface:#f8f7fb;--sans:'Manrope',system-ui,sans-serif;--display:'Space Grotesk',system-ui,sans-serif;--mono:'DM Mono',monospace}
      html{font-size:16px;-webkit-font-smoothing:antialiased}
      body{min-height:100vh;font-family:var(--sans);color:var(--text);background:#fff}
      .login-shell{min-height:100vh;display:grid;grid-template-columns:minmax(380px,.9fr) minmax(480px,1.1fr)}
      .brand-panel{position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;padding:clamp(2rem,5vw,4.5rem);background:linear-gradient(145deg,#f5f1ff 0%,#f8fbfc 72%,#fff 100%);border-right:1px solid var(--border)}
      .brand-panel::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(77,49,163,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(77,49,163,.045) 1px,transparent 1px);background-size:54px 54px;mask-image:linear-gradient(135deg,#000,transparent 80%);pointer-events:none}
      .brand-panel::after{content:'';position:absolute;width:440px;height:440px;right:-180px;bottom:-150px;border:1px solid rgba(108,77,230,.2);border-radius:50%;box-shadow:0 0 0 70px rgba(108,77,230,.035),0 0 0 140px rgba(8,127,140,.025)}
      .brand-logo,.brand-copy,.system-status{position:relative;z-index:1}.brand-logo img{display:block;width:200px;height:auto}
      .brand-copy{max-width:540px;margin-block:auto;padding:5rem 0}
      .eyebrow{display:flex;align-items:center;gap:.6rem;margin-bottom:1.5rem;font:500 .66rem var(--mono);letter-spacing:.13em;text-transform:uppercase;color:var(--muted)}.eyebrow::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--cyan);box-shadow:0 0 9px rgba(8,127,140,.5)}
      .brand-copy h1{font:600 clamp(3rem,5.5vw,5.4rem)/.98 var(--display);letter-spacing:-.065em}.brand-copy h1 span{display:block;background:linear-gradient(100deg,#7655df,#087f8c);background-clip:text;-webkit-background-clip:text;color:transparent}
      .brand-copy p{max-width:460px;margin-top:1.75rem;color:var(--muted);font-size:1rem;line-height:1.75}
      .system-status{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-top:1.25rem;border-top:1px solid var(--border);font:400 .62rem var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.status-online{display:flex;align-items:center;gap:.5rem}.status-online::before{content:'';width:5px;height:5px;border-radius:50%;background:#19a463;box-shadow:0 0 8px rgba(25,164,99,.5)}
      .form-panel{position:relative;display:grid;place-items:center;padding:clamp(2rem,7vw,7rem)}.form-panel::before{content:'ADMIN / AUTH';position:absolute;top:2.5rem;right:3rem;font:400 .6rem var(--mono);letter-spacing:.12em;color:#aaa6b0}
      .login-card{width:100%;max-width:440px}
      .card-header{margin-bottom:2.5rem}.card-number{display:inline-block;margin-bottom:1.1rem;font:500 .64rem var(--mono);letter-spacing:.12em;color:var(--accent)}.card-header h2{font:600 clamp(2rem,4vw,2.8rem)/1.1 var(--display);letter-spacing:-.045em}.card-header p{margin-top:.75rem;color:var(--muted);font-size:.9rem;line-height:1.6}
      .form-group{margin-bottom:1.25rem}label{display:block;margin-bottom:.55rem;font-size:.75rem;font-weight:700;letter-spacing:.02em;color:#494550}
      .input-wrap{position:relative}.input-wrap svg{position:absolute;left:1rem;top:50%;transform:translateY(-50%);width:17px;height:17px;color:#97939d;pointer-events:none}
      input{width:100%;height:52px;padding:0 1rem 0 2.8rem;border:1px solid var(--border);border-radius:11px;background:#fff;color:var(--text);font:.9rem var(--sans);outline:none;transition:border-color .2s,box-shadow .2s,background .2s}input::placeholder{color:#aaa6b0}input:hover{border-color:rgba(108,77,230,.3)}input:focus{border-color:var(--accent);background:#fdfcff;box-shadow:0 0 0 4px rgba(108,77,230,.09)}input:focus + svg{color:var(--accent)}
      .btn{width:100%;height:52px;margin-top:.6rem;border:0;border-radius:999px;background:linear-gradient(120deg,#6849dc,#8065ec);box-shadow:0 10px 28px rgba(86,57,190,.2);color:#fff;font:700 .82rem var(--sans);cursor:pointer;transition:transform .2s,box-shadow .2s}.btn:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(86,57,190,.3)}.btn:active{transform:translateY(0)}
      .alert-error{display:flex;align-items:flex-start;gap:.65rem;margin-bottom:1.5rem;padding:.85rem 1rem;border:1px solid rgba(205,48,48,.2);border-radius:10px;background:#fff6f6;color:#a52e2e;font-size:.8rem;line-height:1.5}.alert-error::before{content:'!';flex:0 0 auto;display:grid;place-items:center;width:18px;height:18px;border:1px solid currentColor;border-radius:50%;font:600 .65rem var(--mono)}
      .back-link{display:flex;align-items:center;justify-content:center;gap:.45rem;margin-top:1.75rem;color:var(--muted);font-size:.76rem;text-decoration:none;transition:color .2s}.back-link:hover{color:var(--accent)}
      @media(max-width:900px){.login-shell{grid-template-columns:1fr}.brand-panel{min-height:auto;padding:1.5rem 2rem;border-right:0;border-bottom:1px solid var(--border)}.brand-logo img{width:168px}.brand-copy{padding:3rem 0 2rem}.brand-copy h1{font-size:clamp(2.8rem,9vw,4.5rem)}.brand-copy p{margin-top:1.25rem}.system-status{display:none}.form-panel{padding:4rem 2rem 5rem}.form-panel::before{top:1.5rem;right:2rem}}
      @media(max-width:540px){.brand-panel{padding:1.25rem}.brand-logo img{width:145px}.brand-copy{padding:2.75rem 0 1.5rem}.brand-copy h1{font-size:2.7rem}.brand-copy p{font-size:.9rem}.form-panel{place-items:start center;padding:3.5rem 1.25rem}.form-panel::before{right:1.25rem;top:1.2rem}.card-header{margin-bottom:2rem}}
      @media(prefers-reduced-motion:reduce){*{transition-duration:.01ms!important}}
    </style>
  </head>
  <body>
    <main class="login-shell">
      <section class="brand-panel" aria-label="Vórtice">
        <a class="brand-logo" href="/" aria-label="Voltar ao Vórtice"><img src="/logo-vortice.svg" alt="Vórtice" width="240" height="60" /></a>
        <div class="brand-copy"><div class="eyebrow">Área restrita</div><h1>Ideias em <span>movimento.</span></h1><p>O espaço editorial para publicar, organizar e acompanhar o conteúdo do Vórtice.</p></div>
        <div class="system-status"><span class="status-online">Sistema disponível</span><span>V.01 / 2026</span></div>
      </section>
      <section class="form-panel">
        <div class="login-card">
          <header class="card-header"><span class="card-number">01 / IDENTIFICAÇÃO</span><h2>Bem-vindo de volta.</h2><p>Insira suas credenciais para acessar o painel administrativo.</p></header>
          {error === 'credenciais' && <div class="alert-error" role="alert">E-mail ou senha inválidos. Verifique os dados e tente novamente.</div>}
          {error === 'erro' && <div class="alert-error" role="alert">Não foi possível entrar agora. Tente novamente em instantes.</div>}
          <form method="POST" action="/api/admin/login">
            <div class="form-group"><label for="email">E-mail</label><div class="input-wrap"><input type="email" id="email" name="email" required autocomplete="email" placeholder="admin@exemplo.com" autofocus /><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg></div></div>
            <div class="form-group"><label for="password">Senha</label><div class="input-wrap"><input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••" /><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></div></div>
            <button type="submit" class="btn">Acessar painel →</button>
          </form>
          <a href="/" class="back-link">← Voltar ao blog</a>
        </div>
      </section>
    </main>
  </body>
</html>

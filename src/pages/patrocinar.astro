---
import Layout from '../layouts/Layout.astro';

const success = Astro.url.searchParams.get('ok') === '1';
const error = Astro.url.searchParams.get('erro');
---

<Layout title="Patrocine o Vórtice" description="Alcance leitores engajados patrocinando o Vórtice.">
  <div class="page-header">
    <h1>Patrocine o Vórtice</h1>
    <p class="subtitle">Conecte sua marca a uma audiência curiosa e engajada.</p>
  </div>

  <section class="benefits">
    <div class="benefit-item">
      <h2>Por que patrocinar?</h2>
      <p>
        O Vórtice é um blog independente sobre tecnologia, cultura e ideias. Nossa audiência é formada
        por profissionais curiosos, leitores atentos e entusiastas de cultura digital.
      </p>
    </div>

    <div class="benefit-grid">
      <div class="benefit-card">
        <h3>Posts patrocinados</h3>
        <p>Conteúdo relevante integrado editorialmente ao blog, com transparência e qualidade.</p>
      </div>
      <div class="benefit-card">
        <h3>Banner de patrocinador</h3>
        <p>Seu nome e link em destaque dentro do artigo, visível a todos os leitores.</p>
      </div>
      <div class="benefit-card">
        <h3>Público qualificado</h3>
        <p>Leitores engajados que buscam conteúdo de qualidade — não de quantidade.</p>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <h2>Demonstre interesse</h2>
    <p>Preencha o formulário abaixo e entraremos em contato para discutir as possibilidades.</p>

    {success && (
      <div class="alert alert-success">
        Recebemos seu interesse! Entraremos em contato em breve.
      </div>
    )}

    {error && (
      <div class="alert alert-error">
        {error === 'url' ? 'Confira as URLs informadas.' : error === 'anuncio' ? 'Preencha o título e o link do anúncio.' : 'Ocorreu um erro. Tente novamente ou envie um e-mail diretamente.'}
      </div>
    )}

    <form class="sponsor-form" method="POST" action="/api/patrocinar">
      <div class="form-group">
        <label for="company_name">Nome da empresa *</label>
        <input type="text" id="company_name" name="company_name" required placeholder="Empresa XYZ" />
      </div>

      <div class="form-group">
        <label for="email">E-mail de contato *</label>
        <input type="email" id="email" name="email" required placeholder="contato@empresa.com" />
      </div>

      <div class="form-group">
        <label for="website">Site da empresa</label>
        <input type="url" id="website" name="website" placeholder="https://empresa.com" />
      </div>

      <div class="form-group">
        <label for="message">Mensagem (opcional)</label>
        <textarea id="message" name="message" rows="4" placeholder="Conte um pouco sobre o produto/serviço e como gostaria de patrocinar..."></textarea>
      </div>

      <fieldset class="campaign-fields">
        <legend>Proposta de anúncio <span>(opcional)</span></legend>
        <p>Você pode enviar uma proposta agora. Ela só será publicada após nossa revisão.</p>
        <div class="form-group"><label for="ad_title">Título do anúncio</label><input type="text" id="ad_title" name="ad_title" maxlength="90" placeholder="Uma chamada curta para sua campanha" /></div>
        <div class="form-group"><label for="description">Descrição curta</label><input type="text" id="description" name="description" maxlength="160" placeholder="Explique a oferta em uma frase" /></div>
        <div class="form-group"><label for="image_url">URL da imagem (desktop)</label><input type="url" id="image_url" name="image_url" placeholder="https://empresa.com/banner.jpg" /></div>
        <div class="form-group"><label for="mobile_image_url">URL da imagem para celular</label><input type="url" id="mobile_image_url" name="mobile_image_url" placeholder="https://empresa.com/banner-mobile.jpg" /></div>
        <div class="form-group"><label for="destination_url">Link de destino</label><input type="url" id="destination_url" name="destination_url" placeholder="https://empresa.com/oferta" /></div>
        <div class="form-group"><label for="placement">Formato desejado</label><select id="placement" name="placement"><option value="top">Topo do artigo</option><option value="bottom">Final do artigo</option><option value="sidebar">Coluna lateral direita</option><option value="sticky">Faixa fixa inferior</option><option value="popup">Pop-up após 5 segundos</option></select></div>
        <div class="form-group"><label for="article_slug">Slug do artigo específico</label><input type="text" id="article_slug" name="article_slug" placeholder="Deixe vazio para aparecer em qualquer artigo" /></div>
      </fieldset>

      <button type="submit" class="btn btn-primary">Enviar interesse</button>
    </form>
  </section>
</Layout>

<style>
  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 7vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1.05rem;
    color: var(--color-muted);
  }

  .benefits {
    margin-bottom: 3.5rem;
  }

  .benefits h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin-bottom: 0.85rem;
  }

  .benefits > .benefit-item > p {
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 580px;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .benefit-card {
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.25rem;
    background: var(--color-surface-soft);
  }

  .benefit-card h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .benefit-card p {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .cta-section h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .cta-section > p {
    color: var(--color-muted);
    margin-bottom: 1.75rem;
  }

  .sponsor-form {
    max-width: 540px;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface-soft);
  }
  .campaign-fields{border:0;border-top:1px solid var(--color-border);margin:2rem 0 1.5rem;padding-top:1.5rem}.campaign-fields legend{padding-right:.7rem;font-family:var(--font-serif);font-weight:700}.campaign-fields legend span{font:400 .7rem var(--font-sans);color:var(--color-muted)}.campaign-fields>p{margin:.4rem 0 1.3rem;color:var(--color-muted);font-size:.82rem;line-height:1.5}

  .alert {
    padding: 0.85rem 1rem;
    border-radius: 6px;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .alert-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
  .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
</style>

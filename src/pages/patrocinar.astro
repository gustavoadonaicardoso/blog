---
import Layout from '../layouts/Layout.astro';

const success = Astro.url.searchParams.get('ok') === '1';
const error = Astro.url.searchParams.get('erro');
---

<Layout title="Patrocine o Vórtice" description="Alcance leitores engajados patrocinando o Vórtice.">
  <div class="page-header">
    <h1>Patrocine o Vórtice</h1>
    <p class="subtitle">Conecte sua marca a uma audiência curiosa e engajada.</p>
  </div>

  <section class="benefits">
    <div class="benefit-item">
      <h2>Por que patrocinar?</h2>
      <p>
        O Vórtice é um blog independente sobre tecnologia, cultura e ideias. Nossa audiência é formada
        por profissionais curiosos, leitores atentos e entusiastas de cultura digital.
      </p>
    </div>

    <div class="benefit-grid">
      <div class="benefit-card">
        <h3>Posts patrocinados</h3>
        <p>Conteúdo relevante integrado editorialmente ao blog, com transparência e qualidade.</p>
      </div>
      <div class="benefit-card">
        <h3>Banner de patrocinador</h3>
        <p>Seu nome e link em destaque dentro do artigo, visível a todos os leitores.</p>
      </div>
      <div class="benefit-card">
        <h3>Público qualificado</h3>
        <p>Leitores engajados que buscam conteúdo de qualidade — não de quantidade.</p>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <h2>Demonstre interesse</h2>
    <p>Preencha o formulário abaixo e entraremos em contato para discutir as possibilidades.</p>

    {success && (
      <div class="alert alert-success">
        Recebemos seu interesse! Entraremos em contato em breve.
      </div>
    )}

    {error && (
      <div class="alert alert-error">
        Ocorreu um erro. Tente novamente ou envie um e-mail diretamente.
      </div>
    )}

    <form class="sponsor-form" method="POST" action="/api/patrocinar">
      <div class="form-group">
        <label for="company_name">Nome da empresa *</label>
        <input type="text" id="company_name" name="company_name" required placeholder="Empresa XYZ" />
      </div>

      <div class="form-group">
        <label for="email">E-mail de contato *</label>
        <input type="email" id="email" name="email" required placeholder="contato@empresa.com" />
      </div>

      <div class="form-group">
        <label for="website">Site da empresa</label>
        <input type="url" id="website" name="website" placeholder="https://empresa.com" />
      </div>

      <div class="form-group">
        <label for="message">Mensagem (opcional)</label>
        <textarea id="message" name="message" rows="4" placeholder="Conte um pouco sobre o produto/serviço e como gostaria de patrocinar..."></textarea>
      </div>

      <button type="submit" class="btn btn-primary">Enviar interesse</button>
    </form>
  </section>
</Layout>

<style>
  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 7vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1.05rem;
    color: var(--color-muted);
  }

  .benefits {
    margin-bottom: 3.5rem;
  }

  .benefits h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin-bottom: 0.85rem;
  }

  .benefits > .benefit-item > p {
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 580px;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .benefit-card {
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.25rem;
    background: var(--color-surface-soft);
  }

  .benefit-card h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .benefit-card p {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .cta-section h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .cta-section > p {
    color: var(--color-muted);
    margin-bottom: 1.75rem;
  }

  .sponsor-form {
    max-width: 540px;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface-soft);
  }

  .alert {
    padding: 0.85rem 1rem;
    border-radius: 6px;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .alert-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
  .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
</style>

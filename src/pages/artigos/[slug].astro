---
import Layout from '../../layouts/Layout.astro';
import SponsorBanner from '../../components/SponsorBanner.astro';
import AdCampaign from '../../components/AdCampaign.astro';
import Comments from '../../components/Comments.astro';
import { createClient } from '../../lib/supabase';
import { marked } from 'marked';
import { copy, formatDate, getLocale, localizePost } from '../../lib/i18n';

const { slug } = Astro.params;
const locale = getLocale(Astro.url);
const labels = copy[locale];

const supabase = createClient(Astro.cookies, Astro.request);

const { data: post } = await supabase
  .from('posts')
  .select('*')
  .eq('slug', slug)
  .eq('published', true)
  .single();

if (!post) {
  return Astro.redirect('/artigos', 302);
}

const localizedPost = localizePost(post, locale);
const contentHtml = localizedPost.content ? marked.parse(localizedPost.content) : '';

const { data: comments } = await supabase
  .from('comments')
  .select('id, name, content, created_at')
  .eq('post_id', post.id)
  .eq('approved', true)
  .order('created_at', { ascending: true });

const { data: availableCampaigns } = await supabase
  .from('ad_campaigns')
  .select('id, sponsor_name, title, description, image_url, mobile_image_url, destination_url, placement, article_slug')
  .order('created_at', { ascending: false });
const campaigns = (availableCampaigns ?? []).filter((campaign) => !campaign.article_slug || campaign.article_slug === slug);
const topAd = campaigns.find((campaign) => campaign.placement === 'top');
const bottomAd = campaigns.find((campaign) => campaign.placement === 'bottom' || campaign.placement === 'inline');
const sidebarAd = campaigns.find((campaign) => campaign.placement === 'sidebar');
const stickyAd = campaigns.find((campaign) => campaign.placement === 'sticky');
const popupAd = campaigns.find((campaign) => campaign.placement === 'popup');

---

<Layout title={localizedPost.title} description={localizedPost.excerpt ?? undefined} image={post.image_url ?? undefined} imageAlt={post.image_alt ?? undefined} article locale={locale}>
  <div class:list={['article-layout', { 'has-sidebar': sidebarAd }]}>
    <article class="post">
      <header class="post-header">
        <div class="post-meta">
          <time datetime={post.created_at}>{formatDate(post.created_at, locale)}</time>
          {post.is_sponsored && <span class="badge">{labels.sponsored}</span>}
        </div>
        <h1 class="post-title">{localizedPost.title}</h1>
        {localizedPost.excerpt && <p class="post-excerpt">{localizedPost.excerpt}</p>}
        {locale !== 'pt-BR' && !localizedPost.translated && <p class="translation-note" role="status">{labels.translationFallback}</p>}
      </header>

      {post.image_url && (
        <figure class="post-hero">
          <img src={post.image_url} alt={post.image_alt || ''} width="1200" height="630" loading="eager" fetchpriority="high" />
        </figure>
      )}

      {topAd && <AdCampaign campaign={topAd} />}

      {post.is_sponsored && post.sponsor_name && (
        <SponsorBanner sponsor_name={post.sponsor_name} sponsor_url={post.sponsor_url ?? undefined} sponsor_badge={post.sponsor_badge ?? undefined} />
      )}

      <div class="post-content" set:html={contentHtml} />

      {bottomAd && <AdCampaign campaign={bottomAd} />}

      {post.is_sponsored && post.sponsor_name && (
        <SponsorBanner sponsor_name={post.sponsor_name} sponsor_url={post.sponsor_url ?? undefined} sponsor_badge={post.sponsor_badge ?? undefined} />
      )}

      <Comments postId={post.id} slug={slug!} comments={comments ?? []} status={Astro.url.searchParams.get('comentario') ?? undefined} locale={locale} />
    </article>
    {sidebarAd && <aside class="article-sidebar" aria-label="Publicidade lateral"><AdCampaign campaign={sidebarAd} /></aside>}
  </div>

  <nav class="post-nav">
    <a href={locale === 'pt-BR' ? '/artigos' : `/artigos?lang=${locale}`} class="back-link">← {labels.backToArticles}</a>
  </nav>
  {stickyAd && <AdCampaign campaign={stickyAd} />}
  {popupAd && <AdCampaign campaign={popupAd} />}
</Layout>

<style>
  .article-layout{display:grid;grid-template-columns:minmax(0,820px);gap:clamp(2rem,4vw,4rem);align-items:start}.article-layout.has-sidebar{grid-template-columns:minmax(0,820px) minmax(240px,300px)}.post{min-width:0}.article-sidebar{min-width:0;padding-top:.25rem}
  .post-header {
    max-width: 780px;
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  .translation-note{margin-top:1rem;padding:.65rem .8rem;border-left:3px solid var(--color-accent);background:var(--color-accent-light);color:var(--color-muted);font-size:.75rem}
  .post-hero{width:100%;max-width:820px;aspect-ratio:1200/630;margin:0 0 2.75rem;overflow:hidden;border:1px solid var(--color-border);border-radius:clamp(12px,2vw,20px);background:var(--color-surface)}.post-hero img{display:block;width:100%;height:100%;object-fit:cover}@media(max-width:600px){.post-hero{width:calc(100% + 2rem);margin-left:-1rem;border-left:0;border-right:0;border-radius:0;aspect-ratio:4/3}}

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  time {
    font-size: 0.82rem;
    color: var(--color-muted);
  }

  .badge {
    display: inline-flex;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2em 0.6em;
    border-radius: 4px;
    background: var(--color-accent-light);
    color: var(--color-accent);
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 0.85rem;
  }

  .post-excerpt {
    font-size: 1.1rem;
    color: var(--color-muted);
    line-height: 1.6;
    font-style: normal;
    max-width: 700px;
  }

  .post-content {
    max-width: 760px;
    line-height: 1.8;
    font-size: 1rem;
  }

  .post-content :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 2rem 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .post-content :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    margin: 1.5rem 0 0.5rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.4rem;
  }

  .post-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-muted);
    font-style: italic;
  }

  .post-content :global(code) {
    background: rgba(255,255,255,.07);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    font-size: 0.875em;
    font-family: 'Fira Code', 'Cascadia Code', monospace;
  }

  .post-content :global(pre) {
    background: #0d0d13;
    border: 1px solid var(--color-border);
    color: #e5e5e5;
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.4rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2.5rem 0;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 1rem 0;
  }

  .post-nav {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }
  @media(max-width:1050px){.article-layout.has-sidebar{grid-template-columns:minmax(0,760px) minmax(210px,260px);gap:2rem}.post-title{font-size:clamp(2.5rem,5vw,4.2rem)}}
  @media(max-width:900px){.article-layout,.article-layout.has-sidebar{display:block}.article-sidebar{max-width:760px}.post-nav{max-width:760px}}
</style>
